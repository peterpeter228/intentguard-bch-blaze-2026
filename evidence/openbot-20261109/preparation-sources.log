## run-command.mjs SHA256=cf6d442275ea32ed9ee8962698095ecabedbecec18e5e5c11727d29c3f158536
import { spawnSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync, appendFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
const root = '/root/work/intentguard-bch';
const out = '/var/lib/docker/volumes/openbot-eval_openbot-data/_data/OpenBot/Shared/loop/bch-blaze-dev-20261109/artifacts';
const phase = process.argv[2];
if (!['baseline', 'final'].includes(phase)) throw Error('invalid phase');
const log = join(out, `${phase}.log`);
const result = join(out, `${phase}-result.json`);
if (existsSync(log) || existsSync(result)) throw Error('refusing repeated execution');
const hash = path => createHash('sha256').update(readFileSync(join(root, path))).digest('hex');
const before = { package: hash('package.json'), lock: hash('package-lock.json') };
const report = { phase, startedAt: new Date().toISOString(), node: process.version, npm: null, source: null, environment: Object.fromEntries(['TMPDIR','npm_config_cache','npm_config_devdir','npm_config_nodedir','PI_CODEX_WEBSOCKET','OMP_TIMEOUT'].map(k => [k,process.env[k] ?? null])), before, commands: [] };
writeFileSync(log, JSON.stringify(report, null, 2) + '\n', { flag: 'wx' });
const commands = [['git', ['rev-parse', 'HEAD']], ['npm', ['--version']], ...(phase === 'baseline' ? [['npm', ['ci', '--ignore-scripts', '--no-fund', '--no-audit']], ['npm', ['rebuild', 'sqlite3', 'better-sqlite3']]] : []), ['npm', ['run', 'validate']]];
for (const [command, args] of commands) {
  const start = Date.now();
  appendFileSync(log, `\n$ ${command} ${args.join(' ')}\nstartedAt=${new Date(start).toISOString()}\n`);
  const run = spawnSync(command, args, { cwd: root, encoding: 'utf8', timeout: command === 'git' ? 20000 : 600000, maxBuffer: 32 * 1024 * 1024, env: process.env });
  appendFileSync(log, (run.stdout ?? '') + (run.stderr ?? '') + `\nexit=${run.status} signal=${run.signal} durationMs=${Date.now()-start}\n`);
  const entry = { command: [command,...args], exit: run.status, signal: run.signal, durationMs: Date.now()-start, errorCode: run.error?.code ?? null };
  if (command === 'git') report.source = run.stdout?.trim();
  if (args[0] === '--version') report.npm = run.stdout?.trim();
  if (args[0] === 'run') entry.testSummary = (run.stdout ?? '').split('\n').filter(line => /^(#|ℹ) (tests|suites|pass|fail|cancelled|skipped|todo|duration_ms) /.test(line));
  report.commands.push(entry);
  console.log(JSON.stringify(entry));
  if (run.status !== 0) break;
}
report.after = { package: hash('package.json'), lock: hash('package-lock.json') };
report.packageAndLockUnchanged = JSON.stringify(before) === JSON.stringify(report.after);
report.finishedAt = new Date().toISOString();
writeFileSync(result, JSON.stringify(report,null,2)+'\n', {flag:'wx'});
console.log(JSON.stringify(report,null,2));
process.exitCode = report.commands.at(-1)?.exit === 0 && report.commands.at(-1)?.command.join(' ') === 'npm run validate' && report.packageAndLockUnchanged ? 0 : 1;


