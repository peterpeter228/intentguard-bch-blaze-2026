import { createHash } from 'node:crypto';
import { writeFileSync, appendFileSync } from 'node:fs';
import { createReviewedChipnetCandidates, REVIEWED_CHIPNET_ENDPOINTS } from '/root/work/intentguard-bch/dist/core/public-sources.js';
import { ELECTRUM_DEADLINE_MS } from '/root/work/intentguard-bch/dist/core/electrum-transport.js';
const log = '/var/lib/docker/volumes/openbot-eval_openbot-data/_data/OpenBot/Shared/loop/bch-blaze-dev-20261109/artifacts/transport-probe.log';
writeFileSync(log, JSON.stringify({startedAt:new Date().toISOString(),node:process.version,deadlineMs:ELECTRUM_DEADLINE_MS,attemptsPerEndpoint:1,retries:0,scope:'existing verified-TLS transport: internal server.version 1.5.0 then one checkpoint header read; no wallet, identity, address, transaction, subscription or broadcast'})+'\n',{flag:'wx'});
for (const source of createReviewedChipnetCandidates()) {
  const start = Date.now();
  const record = {startedAt:new Date(start).toISOString(),endpoint:REVIEWED_CHIPNET_ENDPOINTS.find(e=>e.id===source.id),method:'blockchain.block.header',params:[source.checkpoint.height],deadlineMs:ELECTRUM_DEADLINE_MS,attempt:1,retries:0,expectedCheckpoint:source.checkpoint,status:'UNVERIFIED'};
  try {
    const header = await source.transport.request('blockchain.block.header',[source.checkpoint.height],new AbortController().signal);
    record.rawHeader = header;
    record.transportOutcome = 'RESPONSE_RETURNED';
    if (typeof header === 'string' && /^[0-9a-fA-F]{160}$/.test(header)) {
      const hash = createHash('sha256').update(createHash('sha256').update(Buffer.from(header,'hex')).digest()).digest().reverse().toString('hex');
      record.reportedHeaderHash = hash;
      record.status = hash === source.checkpoint.hash ? 'SINGLE_NODE_CHECKPOINT_MATCH_ONLY' : 'CHECKPOINT_MISMATCH';
    } else record.status = 'INVALID_HEADER';
  } catch(error) {
    record.transportOutcome = error instanceof Error ? error.message : 'UNKNOWN';
    record.status = 'NO_HEADER_RESULT';
  }
  record.durationMs = Date.now()-start;
  record.chainPaymentOrOwnershipVerified = false;
  appendFileSync(log,JSON.stringify(record)+'\n');
  console.log(JSON.stringify(record));
}
appendFileSync(log,JSON.stringify({finishedAt:new Date().toISOString(),walletCreated:false,fundingRequestedSatoshis:'0',signatureCreated:false,engineSessionCreated:false})+'\n');


