101:     /**
102:      * Constructs a new instance of XO Engine.
103:      * @private
104:      * @param {string} mnemonic - The BIP39 mnemonic to be used for this instance of the engine.
105:      * @param {State} state - State instance.
106:      * @param {BlockchainMonitor} blockchainMonitor - Blockchain monitor instance.
107:      * @param {XONetwork} network - Network this instance derives keys and isolates storage for.
108:      */
109:     private constructor(mnemonic: string, state: State, blockchainMonitor: BlockchainMonitor, network: XONetwork) {
110:         // Derive keys on the HD network that matches this network.
111:         this.#crypto = new Crypto(convertMnemonicToSeedBytes(mnemonic), {
112:             network: resolveHdKeyNetwork(network),
113:         });
114: 
115:         // Store the network this instance was created for so later calls use the same network.
116:         this.#network = network;
117: 
118:         this.#state = state;
119:         this.#blockchainMonitor = blockchainMonitor;
120:     }
121: 
122:     /**
123:      * Network this engine instance targets.
124:      *
125:      * @returns {XONetwork} - Network this engine instance targets.
126:      */
127:     get network(): XONetwork {
128:         return this.#network;
129:     }
130: 
131:     /**
132:      * Lists every Electrum server this engine connects to, with the state of each connection.
133:      *
134:      * @returns {ElectrumConnection[]} - One entry per Electrum client, empty before Electrum is initialized.
135:      */
136:     listElectrumConnections(): ElectrumConnection[] {
137:         return listElectrumConnections();
138:     }
139: 
140:     /**
141:      * Reads the chain status the Electrum application last reported, with the reported and verified block heights.
142:      *
143:      * @returns {Promise<ChainStatus>} - Current height, verified height, and verified percent of the chain.
144:      */
145:     async getChainStatus(): Promise<ChainStatus> {
146:         return getChainStatus();
147:     }
148: 
149:     /**
150:      * Initializes and creates a new XO Engine instance.
151:      * Opens storage, configures Electrum, and starts the blockchain monitor.
152:      *
153:      * @param {string} mnemonic - BIP39 mnemonic to be used for this instance of the engine.
154:      * @param {XOEngineOptions} options - Storage, Electrum, network, and remote state settings for this instance.
155:      * @returns {Promise<Engine>} - An initialized Engine instance.
156:      */
157:     static async create(mnemonic: string, options: XOEngineOptions): Promise<Engine> {
158:         const network = options.network ?? DEFAULT_XO_NETWORK;
159: 
160:         // Resolve the Electrum servers for this network.
161:         const resolvedElectrumServers = options.electrumServers ?? resolveElectrumServersForNetwork(network);
162: 
163:         // The storage adapter and the Electrum name both include this hash.
164:         const accountHash = computeAccountHash(mnemonic);
165: 
166:         // Build the database filenames for this network. Each network has its own database.
167:         const networkDatabaseFilename = buildNetworkDatabaseFilename(network, options.databaseFilename);
168: 
169:         // Build the Electrum cache database filename for this account on this network, kept apart from the account database.
170:         const electrumCacheDatabaseFilename = buildElectrumCacheDatabaseFilename(network, accountHash, options.databaseFilename);
171: 
172:         // Configure Electrum.
173:         await initializeElectrumApplication(options.electrumApplicationIdentifier ?? DEFAULT_ELECTRUM_APPLICATION_IDENTIFIER, {
174:             electrumServersOrSockets: resolvedElectrumServers,
175:             databasePath: options.databasePath,
176:             databaseFilename: electrumCacheDatabaseFilename,
177:         });
178: 
179:         // Open the account database for this network.
180:         const storageAdapter = await createStorageAdapter({
181:             storageType: options.storageType ?? DEFAULT_STORAGE_TYPE,
182:             databasePath: options.databasePath,
183:             databaseFilename: networkDatabaseFilename,
184:             accountHash,
185:         });
186: 
187:         // Wrap the adapter so later methods share one State instance.
188:         const stateInstance = new State(storageAdapter);
189: 
190:         // Create the blockchain monitor instance.
191:         const blockchainMonitor = new BlockchainMonitor(stateInstance);
192: 
193:         // Register listeners.
194:         blockchainMonitor.initializeEventListeners();
195: 
196:         // Construct the engine instance.
197:         const engineInstance = new Engine(mnemonic, stateInstance, blockchainMonitor, network);
198: 
199:         // Electrum and the state are open, so subscribe to the stored script hashes and update their unspent outputs.
200:         await engineInstance.#monitorStoredScriptHashes();
201: 
202:         // Return the engine instance.
203:         return engineInstance;
204:     }
