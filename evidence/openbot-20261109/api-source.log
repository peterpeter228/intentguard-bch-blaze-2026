sourceSHA256=8d2b9b52bf74e2b7d526bc4e44e84e7ea0b13834ee97a8f658e057ebf509857b
1: import type { StoredInvitation } from '@xo-cash/state';
2: import { listVariableIdentifiersToGenerate } from '../../template.ts';
3: import { generateTemplatePrivateKeysData } from '../../compilation/secrets.ts';
4: import { trackInvitationScriptHashes } from '../helpers/outputs.ts';
5: import { listCommitSecrets } from '../helpers/secrets.ts';
6: import type { AccountContext, InvitationCreationParameters } from '../interfaces.ts';
7: import { InvitationBuilder } from './builder.ts';
8: import { resolveParticipationRole } from './role.ts';
9: import { assertEntityFollowUpRoles } from '../validation/follow-up-roles.ts';
10: 
11: /**
12:  * Creates an invitation that can be shared with other entities, user, application, etc.
13:  * Invitation is the fundamental communication unit in XO, all the interactions done using the
14:  * xo template are done using invitations.
15:  *
16:  * @param {Required<AccountContext>} context - State, signing, and network for this account.
17:  * @param {InvitationCreationParameters} params - The parameters for invitation creation, including the role or intent this account acts on.
18:  * @returns {Promise<StoredInvitation>} - The constructed invitation as stored, including this account's entity identifier.
19:  * @throws {@link TemplateNotFoundInStoreError} - If the template is not found.
20:  * @throws {@link TemplateActionNotFoundError} - If the action is not found.
21:  * @throws {@link InvitationIntentMismatchError} - If the intent names another template or action.
22:  * @throws {@link InvitationRoleDuplicatedError} - If the role is given both directly and on the intent.
23:  * @throws {@link TemplateActionRoleNotFoundError} - If the action does not define the role.
24:  * @throws {@link TemplateGeneratedVariableTypeUnsupportedError} - If a variable to generate is not a private key.
25:  * @throws {@link UnspentOutputReservationExternalConflictError} - If a local outpoint is already reserved by another invitation.
26:  * @throws {@link UnspentOutputReservationInternalConflictError} - If a local outpoint is already reserved by this invitation.
27:  * @throws {@link SecretDataNotFoundError} - If a script hash of this account lists a secret that is not stored.
28:  * @throws {@link EntityMultipleRolesWithFollowUpUnsupportedError} - If the first commit gives this account more than one role with a follow up.
29:  * @todo Create an event for the new invitation and push it to the encryption server.
30:  * @todo Expire the invitation, remove it from storage after it expires, and emit an event for the expiration.
31:  * @todo Sync the invitation with the remote servers.
32:  */
33: export const createInvitation = async (context: Required<AccountContext>, params: InvitationCreationParameters): Promise<StoredInvitation> => {
34:     const { state, crypto, network } = context;
35: 
36:     // Get the template from the state.
37:     const storedTemplate = await state.getTemplateOrThrow(params.templateIdentifier);
38:     const template = storedTemplate.template;
39: 
40:     // The intent and the role decide which keys are generated. Both are checked before anything is signed or stored.
41:     const roleIdentifier = resolveParticipationRole(params, params.templateIdentifier, params.actionIdentifier);
42:     const generatedVariableIdentifiers = listVariableIdentifiersToGenerate(
43:         template,
44:         params.actionIdentifier,
45:         roleIdentifier,
46:         params.intent?.generate,
47:     );
48: 
49:     // Create an invitation builder
50:     const invitationBuilder = new InvitationBuilder(params, network);
51:     const invitationCommit = invitationBuilder.createUnsignedCommit({
52:         variables: params.variables,
53:         inputs: params.inputs,
54:         outputs: params.outputs,
55:         resolutions: params.resolutions,
56:         roleIdentifier,
57:         expiresAtTimestamp: params.expiresAtTimestamp,
58:     });
59: 
60:     // Generate the root commit identifier for the invitation. This commit is the first commit of the invitation for this
61:     // entity and hence it's also the root commit identifier.
62:     // The invitation when stored will also store this identifier to re-create the identity(extended public key) of the entity.
63:     const rootCommitIdentifier = invitationCommit.commitIdentifier;
64: 
65:     // Create an unsigned invitation commit and sign it.
66:     const signedCommit = crypto.signInvitationCommitWithSchnorr({
67:         invitationCommit,
68:         invitationIdentifier: invitationBuilder.invitationIdentifier,
69:         rootCommitIdentifier,
70:         templateIdentifier: invitationBuilder.templateIdentifier,
71:         actionIdentifier: invitationBuilder.actionIdentifier,
72:     });
73: 
74:     // Add the signed commit to the builder.
75:     invitationBuilder.addCommit(signedCommit);
76: 
77:     // Build the invitation, i.e. make an object
78:     const invitation = invitationBuilder.build();
79: 
80:     // The first commit may name a role and tag items with roles, and an entity holds at most one role with a follow up.
81:     assertEntityFollowUpRoles(invitation, template);
82: 
83:     // Store the invitation and entity identifier
84:     const storedInvitation: StoredInvitation = {
85:         invitation,
86:         entityIdentifier: signedCommit.entityIdentifier,
87:     };
88: 
89:     // Keys the intent and the role ask for are generated now and introduced with this account's first commit.
90:     const commitSecrets = await generateTemplatePrivateKeysData(state, params.templateIdentifier, generatedVariableIdentifiers);
91: 
92:     // Outputs of this account's commit locked to scripts it generated introduce their secrets with that commit too.
93:     const outputSecretsByCommitIdentifier = await listCommitSecrets(state, signedCommit, invitation.invitationIdentifier);
94: 
95:     if (outputSecretsByCommitIdentifier !== undefined) {
96:         commitSecrets.push(...outputSecretsByCommitIdentifier[signedCommit.commitIdentifier]);
97:     }
98: 
99:     if (commitSecrets.length > 0) {
100:         storedInvitation.secretsByCommitIdentifier = { [signedCommit.commitIdentifier]: commitSecrets };
101:     }
102: 
103:     await state.storeNewInvitation(invitation.invitationIdentifier, storedInvitation);
104: 
105:     // Read the invitation back so tracking uses the fields storage sets.
106:     const createdStoredInvitation = await state.getInvitationOrThrow(invitation.invitationIdentifier);
107: 
108:     // Outputs this account provided are stored before its inputs are reserved, so a fetched outpoint can be reserved.
109:     await trackInvitationScriptHashes(context, createdStoredInvitation);
110: 
111:     // Only a commit that adds inputs has outpoints of this account to reserve.
112:     if (params.inputs !== undefined) {
113:         await state.reserveOwnUnspentOutputsForInvitation(invitation.invitationIdentifier, params.inputs);
114:     }
115: 
116:     // Return the invitation as stored, with the fields storage sets such as its timestamps.
117:     return state.getInvitationOrThrow(invitation.invitationIdentifier);
118: };
119: 

## node_modules/@xo-cash/utils/dist/index.mjs.map sources[11] = ../source/invitation/serialization.ts
sourceSHA256=5d4d7de9de0c4fceff2af915ca08e8b3206bcf2510719608ce6b298a647a2173
1: import type { XOInvitation } from '@xo-cash/types';
2: import { fromExtendedJson, toExtendedJson } from '../extended-json.ts';
3: import { InvitationJsonMalformedError, InvitationSerializationFailedError } from './errors.ts';
4: import { parseInvitation } from './parser.ts';
5: 
6: /**
7:  * Serializes an invitation for sharing. Encodes bigint and Uint8Array fields using Extended JSON.
8:  *
9:  * @param invitation Shared invitation to export.
10:  * @returns JSON string that {@link deserializeInvitation} can restore.
11:  * @throws {InvitationSerializationFailedError} When JSON serialization fails.
12:  */
13: export const serializeInvitation = (invitation: XOInvitation): string => {
14:     try {
15:         return toExtendedJson(invitation);
16:     } catch (serializationError) {
17:         const reason = serializationError instanceof Error ? serializationError.message : 'unknown error while serializing invitation';
18: 
19:         throw new InvitationSerializationFailedError(reason);
20:     }
21: };
22: 
23: /**
24:  * Deserializes a shared invitation JSON string into an invitation.
25:  *
26:  * Every field is checked against its declared type, so the returned invitation can be trusted to match
27:  * {@link XOInvitation}.
28:  *
29:  * @param serializedInvitation JSON produced by {@link serializeInvitation}.
30:  * @returns Parsed invitation whose fields match their declared types.
31:  * @throws {InvitationJsonMalformedError} When the string is not valid JSON.
32:  * @throws {InvitationInvalidError} When the parsed value does not match the XOInvitation type.
33:  */
34: export const deserializeInvitation = (serializedInvitation: string): XOInvitation => {
35:     let parsedValue: unknown;
36: 
37:     try {
38:         parsedValue = fromExtendedJson(serializedInvitation);
39:     } catch (parsingError) {
40:         const reason = parsingError instanceof Error ? parsingError.message : 'unknown error while deserializing invitation';
41: 
42:         throw new InvitationJsonMalformedError(reason);
43:     }
44: 
45:     return parseInvitation(parsedValue);
46: };
47: 

