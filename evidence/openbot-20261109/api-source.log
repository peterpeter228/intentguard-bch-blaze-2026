sourceSHA256=3be9d3a454b432dfd553579e01e95d42f249f0e90217465b6ee807b706cb109e
128: export const initializeElectrumNetwork = async function(application: string, serversOrSockets: ElectrumBlockchainConnections, encrypted: boolean, requiredBlockchain: Blockchain): Promise<void>
129: {
130: 	// Determine the required anchor and checkpoint for the provided blockchain.
131: 	const requiredAnchor = await getUniqueAnchorCheckpoint(requiredBlockchain);
132: 	const requiredCheckpoint = requiredBlockchain.checkpoint;
133: 
134: 	// Prepare and verify one client. A failure skips that client only.
135: 	const connectAndVerifyClient = async function(serverOrSocket: ElectrumBlockchainConnections[number]): Promise<void>
136: 	{
137: 		// Initialize an empty placeholder for an electrum client.
138: 		let electrumClient: ElectrumClient<ElectrumProtocolEvents>;
139: 
140: 		try
141: 		{
142: 			// Try to prepare the electrum client..
143: 			electrumClient = await prepareElectrumClient(application, serverOrSocket, encrypted);
144: 
145: 			// TODO: Validate protocol version on all clients.
146: 
147: 			// ..then verify that it is using the correct blockchain.
148: 			await verifyElectrumClient(electrumClient, requiredAnchor, requiredCheckpoint);
149: 		}
150: 		catch (error)
151: 		{
152: 			// Log a warning message indicating why we are skipping this host.
153: 			console.warn(`Skipping host: ${error}`);
154: 
155: 			// Disconnect from the client, if preparation got far enough to create one.
156: 			await electrumClient?.disconnect();
157: 
158: 			// Do not add this client to the initialized network.
159: 			return;
160: 		}
161: 
162: 		// Add the electrum client to the list of initialized network clients.
163: 		electrumClients.set(electrumClient.hostIdentifier, electrumClient);
164: 	};
165: 
166: 	// Connect all clients at once.
167: 	await Promise.all(serversOrSockets.map(connectAndVerifyClient));
168: };

