181: export const generateSchnorrSignedInvitationCommit = (params: {
182:     purposeHDNode: HdPrivateNodeValid;
183:     invitationCommit: Omit<XOInvitationCommit, 'signature' | 'entityIdentifier'>;
184:     invitationIdentifier: XOInvitationIdentifier;
185:     rootCommitIdentifier: XOInvitationCommitIdentifier;
186:     templateIdentifier: XOTemplateIdentifier;
187:     actionIdentifier: XOTemplateActionIdentifier;
188:     network: HdKeyNetwork;
189: }): XOInvitationCommit => {
190:     const { purposeHDNode, invitationCommit, invitationIdentifier, rootCommitIdentifier, templateIdentifier, actionIdentifier, network } = params;
191: 
192:     // Resolve the purpose path and derive the invitation private node. Its private key is zeroed in the finally block below.
193:     const invitationPrivateNode = deriveInvitationPrivateNode(purposeHDNode, templateIdentifier, rootCommitIdentifier, getPurposePath(network));
194: 
195:     try {
196:         // Derive the invitation public node and encode it as an invitation entity identifier.
197:         const invitationPublicNode = deriveHdPublicNode(invitationPrivateNode);
198: 
199:         // Encode the invitation public node as an invitation entity identifier.
200:         const entityIdentifier = encodeInvitationEntityIdentifier(invitationPublicNode, network);
201: 
202:         // Hash the commit identifier to derive the non-hardened child index for this commit.
203:         // The commit identifier is generated by the signer, so no external party can influence
204:         // which child key is selected.
205:         const commitIndexSource = sha256.hash(hexToBin(invitationCommit.commitIdentifier));
206: 
207:         // Create the commit index from the commit index source.
208:         // The first four bytes of the hash are used to derive the index.
209:         const commitIndex = createPathIndexFromHash(commitIndexSource);
210: 
211:         // Convert the commit index to a string for the relative path to the commit signing node.
212:         const commitRelativePath = String(commitIndex);
213: 
214:         // Derive the non-hardened commit signing node from the invitation private node.
215:         const commitSigningNode = deriveHdPathRelative(invitationPrivateNode, commitRelativePath);
216: 
217:         // Make sure that the derivation did not produce an error string.
218:         if (typeof commitSigningNode === 'string') {
219:             throw new PurposeNodeDerivationFailedError(commitRelativePath, commitSigningNode);
220:         }
221: 
222:         // Make sure that the commit signing node private key passes secp256k1 validation.
223:         if (!secp256k1.validatePrivateKey(commitSigningNode.privateKey)) {
224:             throw new CommitSigningHdNodePrivateKeyInvalidError(commitRelativePath);
225:         }
226: 
227:         // Build the signing payload from the commit data and all identifier fields.
228:         const commitSigningPayload = buildInvitationCommitSigningPayload({
229:             data: invitationCommit.data,
230:             invitationIdentifier,
231:             templateIdentifier,
232:             actionIdentifier,
233:             commitIdentifier: invitationCommit.commitIdentifier,
234:             previousCommitIdentifier: invitationCommit.previousCommitIdentifier,
235:         });
236: 
237:         // Convert the signing payload to bytes and hash it for signing.
238:         const commitSigningPayloadHash = sha256.hash(utf8ToBin(commitSigningPayload));
239: 
240:         // Sign the payload hash with the commit signing key.
241:         const signature = secp256k1.signMessageHashSchnorr(commitSigningNode.privateKey, commitSigningPayloadHash);
242: 
243:         // Zero the commit signing key immediately after use regardless of outcome.
244:         commitSigningNode.privateKey.fill(0);
245: 
246:         // Make sure that the signature is not an error string.
247:         if (typeof signature === 'string') {
248:             throw new SchnorrSignatureGenerationFailedError(invitationCommit.commitIdentifier, signature);
249:         }
250: 
251:         // Return the signed invitation commit.
252:         return {
253:             ...invitationCommit,
254:             signature: binToHex(signature),
255:             entityIdentifier,
256:         };
257:     } finally {
258:         // Zero the invitation node private key. This runs whether signing succeeded or failed.
259:         invitationPrivateNode.privateKey.fill(0);
260:     }
261: };
