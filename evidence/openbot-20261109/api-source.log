sourceSHA256=44d46b4d5da21cb1e34f8f2732f7e6bc757d5262b9b0031edc0342ea9d4df754
1: import type { HdKeyNetwork } from '@bitauth/libauth';
2: import {
3:     chipnetServersWithBlockchain,
4:     mainnetServersWithBlockchain,
5:     testnet4ServersWithBlockchain,
6:     type ElectrumServersWithBlockchain,
7: } from '@electrum-cash/servers';
8: import { computeAccountHash } from '@xo-cash/crypto';
9: import { DEFAULT_ACCOUNT_DATABASE_FILENAME, DEFAULT_ELECTRUM_CACHE_DATABASE_FILENAME, XO_SUPPORTED_NETWORKS, type XONetwork } from '../defaults.ts';
10: 
11: /**
12:  * Returns true when the value is a supported network.
13:  *
14:  * @param {string} value - Network name to test.
15:  * @returns {boolean} - Whether the value is a supported {@link XONetwork}.
16:  */
17: export const isXOSupportedNetwork = (value: string): value is XONetwork => {
18:     return value === XO_SUPPORTED_NETWORKS.mainnet || value === XO_SUPPORTED_NETWORKS.chipnet || value === XO_SUPPORTED_NETWORKS.testnet4;
19: };
20: 
21: /**
22:  * Maps an engine network to the libauth HD key network used for the purpose path and xpub or tpub encoding.
23:  *
24:  * Libauth {@link HdKeyNetwork} is only `mainnet` or `testnet`. Chipnet and testnet4 are not members of that type, so both use `testnet`.
25:  *
26:  * @param {XONetwork} network - Engine network.
27:  * @returns {HdKeyNetwork} - Mainnet encoding, or testnet encoding for chipnet and testnet4.
28:  */
29: export const resolveHdKeyNetwork = (network: XONetwork): HdKeyNetwork => {
30:     if (network === XO_SUPPORTED_NETWORKS.mainnet) {
31:         return 'mainnet';
32:     }
33: 
34:     // Chipnet and testnet4 are not HdKeyNetwork values, so they share the testnet purpose path and tpub encoding.
35:     return 'testnet';
36: };
37: 
38: /**
39:  * Resolves default Electrum hosts for a network.
40:  *
41:  * Each host carries the blockchain checkpoint and consensus parameters of that network.
42:  *
43:  * @param {XONetwork} network - Engine network.
44:  * @returns {ElectrumServersWithBlockchain} - Server list for that network.
45:  */
46: export const resolveElectrumServersForNetwork = (network: XONetwork): ElectrumServersWithBlockchain => {
47:     if (network === XO_SUPPORTED_NETWORKS.chipnet) {
48:         return chipnetServersWithBlockchain;
49:     }
50: 
51:     if (network === XO_SUPPORTED_NETWORKS.testnet4) {
52:         return testnet4ServersWithBlockchain;
53:     }
54: 
55:     // Mainnet keeps the published @electrum-cash/servers list.
56:     return mainnetServersWithBlockchain;
57: };
58: 
59: /**
60:  * Builds the database filename for a network.
61:  *
62:  * Every network appends the network name to the provided database filename, or to `XO` when none is provided.
63:  *
64:  * @param {XONetwork} network - Engine network.
65:  * @param {string} [databaseFilename] - Optional name included before the network name.
66:  * @returns {string} - Database filename for the network.
67:  */
68: export const buildNetworkDatabaseFilename = (network: XONetwork, databaseFilename?: string): string => {
69:     return `${databaseFilename ?? DEFAULT_ACCOUNT_DATABASE_FILENAME}-${network}`;
70: };
71: 
72: /**
73:  * Builds the database name used for one mnemonic on one network.
74:  *
75:  * @param {string} mnemonic - BIP39 mnemonic for the account.
76:  * @param {XONetwork} network - Engine network.
77:  * @param {string} [databaseFilename] - Optional name that already replaces `XO`.
78:  * @returns {string} - Full database name including account hash.
79:  */
80: export const buildAccountDatabaseName = (mnemonic: string, network: XONetwork, databaseFilename?: string): string => {
81:     const networkDatabaseFilename = buildNetworkDatabaseFilename(network, databaseFilename);
82:     const accountHash = computeAccountHash(mnemonic);
83: 
84:     return `${networkDatabaseFilename}-${accountHash}`;
85: };
86: 
87: /**
88:  * Builds the Electrum cache database filename for one account on one network.
89:  *
90:  * The name always includes `Electrum`, so it never matches the account database name built from the same database filename.
91:  *
92:  * @param {XONetwork} network - Engine network.
93:  * @param {string} accountHash - Account hash for this mnemonic.
94:  * @param {string} [databaseFilename] - Optional name included before `Electrum`.
95:  * @returns {string} - Cache database filename.
96:  */
97: export const buildElectrumCacheDatabaseFilename = (network: XONetwork, accountHash: string, databaseFilename?: string): string => {
98:     const electrumCacheDatabaseFilename = `${DEFAULT_ELECTRUM_CACHE_DATABASE_FILENAME}-${network}-${accountHash}`;
99: 
100:     // A provided database filename is kept in front so every database of this engine shares that name.
101:     if (databaseFilename !== undefined) {
102:         return `${databaseFilename}-${electrumCacheDatabaseFilename}`;
103:     }
104: 
105:     return electrumCacheDatabaseFilename;
106: };
107: 

