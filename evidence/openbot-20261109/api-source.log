1076:     /**
1077:      * Subscribes to Electrum updates for every stored script hash,
1078:      * and replaces the stored unspent outputs of each one with the list Electrum reports.
1079:      *
1080:      * Fails with the first subscribe, fetch, or store update that fails.
1081:      *
1082:      * @returns {Promise<void>} - Resolves when every stored script hash is subscribed and its unspent outputs are updated.
1083:      */
1084:     async #monitorStoredScriptHashes(): Promise<void> {
1085:         const scriptHashDataList = await this.#state.listScriptHashes();
1086: 
1087:         const syncPromises = scriptHashDataList.map(async (scriptHashData) => {
1088:             // Subscribe to update notifications for the script hash.
1089:             await monitorScriptHash(scriptHashData.scriptHash);
1090: 
1091:             // Fetch the current unspent outputs and persist them.
1092:             const unspentOutputsFromBlockchain = await fetchScriptHashUnspentOutputs(scriptHashData.scriptHash);
1093: 
1094:             await updateUnspentOutputsForScriptHash(this.#state, scriptHashData.scriptHash, unspentOutputsFromBlockchain);
1095:         });
1096:         await Promise.all(syncPromises);

