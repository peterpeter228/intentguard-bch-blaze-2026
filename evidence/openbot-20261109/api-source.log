## node_modules/@xo-cash/state/dist/index.mjs.map sources[10] = ../source/storages/create.ts
sourceSHA256=dbf6583966c7945e66af7a55c333c69faa7afe833de44e12460382215fc58f8b
1: import { validateAccountHash } from '@xo-cash/crypto';
2: import { IndexedDBStorage } from './indexeddb/index.ts';
3: import { StorageTypeUnsupportedError } from '../errors.ts';
4: import { StorageType, type StorageConfig, type XOStorage } from './types.ts';
5: import { SQLiteStorage } from './sqlite/index.ts';
6: import { DEFAULT_DATABASE_PATH, DEFAULT_DATABASE_FILENAME } from './defaults.ts';
7: 
8: /**
9:  * Creates a new storage adapter.
10:  *
11:  * @param {StorageConfig} config - Storage configuration options
12:  * @param {StorageType} config.storageType - Type of storage to use (INDEXEDDB, SQLITE, etc.)
13:  * @param {string} config.accountHash - SHA256 hash used for identifying the account for data storage.
14:  * @param {string} [config.databasePath] - Optional path where database files are stored
15:  * @param {string} [config.databaseFilename] - Optional base name for the database file. Defaults to "XO".
16:  * @returns {Promise<XOStorage>} Promise that resolves to a new storage adapter instance
17:  * @throws {StorageTypeUnsupportedError} If the given storage type is not supported.
18:  * @warning Currently config only controls naming. As new options are added to StorageConfig, care must
19:  * be taken when passing them through here as some options may alter database behavior or break expected
20:  * behavior if applied incorrectly.
21:  */
22: export const createStorageAdapter = async (config: StorageConfig): Promise<XOStorage> => {
23:     // The account hash is expected here instead of getting the seed and hashing it OR any other derivation source,
24:     // this responsibility is delegated to the caller of this function.
25:     validateAccountHash(config.accountHash);
26: 
27:     const baseName = config.databaseFilename ?? DEFAULT_DATABASE_FILENAME;
28:     const databaseFilename = `${baseName}-${config.accountHash}`;
29: 
30:     switch (config.storageType) {
31:         case StorageType.INDEXEDDB: {
32:             const indexeddb = new IndexedDBStorage({
33:                 databasePath: config.databasePath ?? DEFAULT_DATABASE_PATH,
34:                 databaseFilename,
35:             });
36: 
37:             // If the database already exists, it will be opened.
38:             await indexeddb.initialize();
39: 
40:             return indexeddb;
41:         }
42: 
43:         case StorageType.SQLITE: {
44:             const sqlite = new SQLiteStorage({
45:                 databasePath: config.databasePath ?? DEFAULT_DATABASE_PATH,
46:                 databaseFilename,
47:             });
48: 
49:             // If the database already exists, it will be opened.
50:             await sqlite.initialize();
51: 
52:             // @ts-expect-error - Full implementation of XOStorage interface is not yet complete.
53:             return sqlite;
54:         }
55: 
56:         default:
57:             throw new StorageTypeUnsupportedError(config.storageType);
58:     }
59: };
60: 

