## preseason/xo/inspect.ts
1: /** Pre-event, offline triage. Never authorizes a wallet operation. */
2: import { parseTemplate, deserializeInvitation, generateTemplateIdentifier } from '@xo-cash/utils';
3: import { listInvitationValidationIssues, XO_SUPPORTED_NETWORKS,
4:   assertCommitsDoNotChangeCommittedFields, assertEntityFollowUpRoles,
5:   assertRoleVariablesProvidedByRoleEntities } from '@xo-cash/engine';
27: export function inspectInvitation(input: InspectionInput): InspectionReport {
28:   const report: InspectionReport = {
29:     schemaVersion: 'intentguard.xo.offline-report.v1', status: 'REJECTED', canSign: false,
30:     checkedAt: Number.isSafeInteger(input.now) && input.now >= 0 && input.now <= 8640000000000000 ? new Date(input.now).toISOString() : null,
31:     network: input.network, templateIdentifier: null, action: null, commits: 0, issues: [],
32:     limitations: ['No wallet connection, signing, broadcast or chain queries.',
33:       'Schema and signature checks do not establish contract safety or user intent.',
34:       'UTXO availability, transaction outputs/fees and execution are NOT verified.',
35:       'No contest eligibility or bounty completion is established.']
36:   };
37:   const issue = (code: string, message: string) => report.issues.push({code,message});
38:   if (!report.checkedAt) { issue('INVALID_CLOCK','Use a safe non-negative Unix millisecond timestamp.'); return report; }
39:   if (input.network !== 'chipnet' && input.network !== 'mainnet') { issue('UNSUPPORTED_NETWORK','Select chipnet or mainnet explicitly.'); return report; }
40:   if (new TextEncoder().encode(input.templateJson).byteLength > 262144 || new TextEncoder().encode(input.invitationJson).byteLength > 262144) { issue('INPUT_TOO_LARGE','Each document must be at most 256 KiB of text.'); return report; }
41:   try {
42:     const template = parseTemplate(input.templateJson);
43:     const invitation = deserializeInvitation(input.invitationJson);
44:     report.templateIdentifier = generateTemplateIdentifier(template);
45:     report.commits = invitation.commits.length;
46:     if (invitation.commits.length > 100) { issue('TOO_MANY_COMMITS','This bounded inspector supports at most 100 commits.'); return report; }
47:     report.action = invitation.actionIdentifier;
48:     if (!/^[a-f0-9]{64}$/.test(input.expectedTemplateIdentifier)) issue('MISSING_TRUST_PIN','Supply a separately reviewed template SHA-256 identifier. The imported template is not its own trust proof.');
49:     else if (input.expectedTemplateIdentifier !== report.templateIdentifier) issue('UNTRUSTED_TEMPLATE','The template differs from the independently selected reference.');
50:     for (const error of listInvitationValidationIssues(invitation,template,XO_SUPPORTED_NETWORKS[input.network])) issue(error.name,error.message);
51:     // Engine acceptance performs these separately; its public validation helper alone is insufficient.
52:     for (const check of [assertCommitsDoNotChangeCommittedFields,assertRoleVariablesProvidedByRoleEntities,assertEntityFollowUpRoles]) {
53:       try { check(invitation,template); } catch(error) { issue(error instanceof Error ? error.name : 'ENGINE_CHECK_FAILED', error instanceof Error ? error.message : 'Engine check failed.'); }
54:     }
55:     if (!Number.isSafeInteger(invitation.createdAtTimestamp)) issue('UNSAFE_TIMESTAMP','Invitation timestamp must be safe integer milliseconds.');
56:     if (invitation.createdAtTimestamp > input.now) issue('FUTURE_INVITATION','Invitation creation timestamp is in the future.');
57:     if (!invitation.commits.length) issue('EMPTY_INVITATION','An unsigned empty invitation is not an executable payment.');
58:     for (const commit of invitation.commits) {
59:       if (!Number.isSafeInteger(commit.createdAtTimestamp) || !Number.isSafeInteger(commit.expiresAtTimestamp)) issue('UNSAFE_TIMESTAMP','Commit timestamps must be safe integer milliseconds.');
60:       if (commit.createdAtTimestamp > input.now) issue('FUTURE_COMMIT','A commit claims a future creation time.');
61:       if (commit.expiresAtTimestamp <= input.now || commit.expiresAtTimestamp <= commit.createdAtTimestamp) issue('EXPIRED_COMMIT','A commit is expired or has an invalid lifetime. The upstream engine currently does not enforce expiry.');
62:     }
63:     // Even zero findings are not payment approval: this slice cannot verify a constructed transaction or UTXOs.
64:     report.status = report.issues.length ? 'REJECTED' : 'REVIEW_REQUIRED';
65:   } catch(error) {
66:     issue('INVALID_DOCUMENT', error instanceof Error ? error.message.slice(0,1000) : 'Unable to validate input.');
67:   }
68:   return report;

