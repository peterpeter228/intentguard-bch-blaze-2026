1161:  * @example const electrumEvents = await initializeElectrumApplication('YourAppNameHere');
1162:  */
1163: export const initializeElectrumApplication = async function(application: string, options?: ElectrumOptions): Promise<EventEmitter<ElectrumApplicationEvents>>
1164: {
1165: 	// ...
1166: 	const defaultElectrumOptions =
1167: 	{
1168: 		electrumServersOrSockets: defaultServers,
1169: 		electrumEncryption: true,
1170: 	};
1171: 
1172: 	// Merge the provided options with the defaults.
1173: 	const currentOptions = { ...defaultElectrumOptions, ...options };
1174: 
1175: 	// Extract the final transport scheme and electrum servers.
1176: 	const { electrumServersOrSockets, electrumEncryption } = currentOptions;
1177: 
1178: 	// Determine the first servers or sockets associated blockchain.
1179: 	const selectedBlockchain = electrumServersOrSockets[0].blockchain;
1180: 
1181: 	// Get a unique blockchain hash for the selected blockchain.
1182: 	const uniqueBlockchainHash = await getUniqueBlockchainHash(selectedBlockchain);
1183: 
1184: 	// Create a connection with the electrum network in the background while we open the database.
1185: 	const networkInitializationPromise = initializeElectrumNetwork(application, electrumServersOrSockets, electrumEncryption, selectedBlockchain);
1186: 
1187: 	// Configure storage layer before first use.
1188: 	await configureDatabase({ ...options }, uniqueBlockchainHash);
1189: 
1190: 	// Use the first servers or sockets blockchain for this application.
1191: 	await setActiveBlockchain(selectedBlockchain);
1192: 
1193: 	// Wait for the connection to the electrum network to be initialized.
1194: 	await networkInitializationPromise;
1195: 
1196: 	// For each server we are connected to..
1197: 	for(const [ electrumServer, electrumClient ] of electrumClients.entries())
1198: 	{
1199: 		// Listen for notifications
1200: 		electrumClient.on('blockchain.headers.subscribe', processHeaderNotification.bind(this, electrumServer));
1201: 		electrumClient.on('blockchain.address.subscribe', processAddressNotification.bind(this, electrumServer));
1202: 		electrumClient.on('blockchain.scripthash.subscribe', processScriptHashNotification.bind(this, electrumServer));
1203: 		electrumClient.on('blockchain.transaction.subscribe', processTransactionNotification.bind(this, electrumServer));
1204: 		electrumClient.on('blockchain.transaction.dsproof.subscribe', processDoublespendNotification.bind(this, electrumServer));
1205: 
1206: 		// Listen for network events.
1207: 		electrumClient.on('connecting', electrumEvents.emit.bind(electrumEvents, 'connecting'));
1208: 		electrumClient.on('connected', electrumEvents.emit.bind(electrumEvents, 'connected'));
1209: 		electrumClient.on('reconnecting', electrumEvents.emit.bind(electrumEvents, 'reconnecting'));
1210: 		electrumClient.on('disconnecting', electrumEvents.emit.bind(electrumEvents, 'disconnecting'));
1211: 		electrumClient.on('disconnected', electrumEvents.emit.bind(electrumEvents, 'disconnected'));
1212: 	}
1213: 
1214: 	// Get the current internal checkpoint.
1215: 	let internalCheckpoint = await getCheckpointWithMerkleMountainRange();
1216: 
1217: 	// Initialize the internal checkpoint if not already present.
1218: 	if(!internalCheckpoint)
1219: 	{
1220: 		internalCheckpoint = await bootstrapCheckpointWithMerkleMountainRangeFromNetwork(uniqueBlockchainHash);
1221: 	}
1222: 
1223: 	// Initialize the current chain status to our internal height, keeping the verified percent to 0 for now.
1224: 	// NOTE: For chains where the internal checkpoint could be 0, this will default to the blockchains checkpoint that is also 0.
1225: 	currentChainStatus.verifiedHeight = internalCheckpoint.height || selectedBlockchain.checkpoint.height;
1226: 
1227: 	// Issue an event with our initial chain status.
1228: 	electrumEvents.emit('ChainStatus', currentChainStatus);
1229: 
1230: 	// TODO: Get and validate internal state (checkpoint, blockheight, chainwork etc)
1231: 
1232: 	// Set up tracking for blockheader events.
1233: 	await monitorBlockchain();
1234: 
1235: 	// Return the event emitter.
1236: 	return electrumEvents;
1237: };

