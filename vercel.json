{
  "buildCommand": "npm run build:production",
  "outputDirectory": "dist/production/public",
  "rewrites": [
    { "source": "/payment.js", "destination": "/visitor-payment.js" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/request", "destination": "/request.html" },
    { "source": "/notices", "destination": "/notices/index.html" },
    { "source": "/notices/", "destination": "/notices/index.html" },
    { "source": "/health", "destination": "https://intentguard-api-production.up.railway.app/health" },
    { "source": "/api/payment-config", "destination": "https://intentguard-api-production.up.railway.app/api/payment-config" },
    { "source": "/api/payment", "destination": "https://intentguard-api-production.up.railway.app/api/payment" },
    { "source": "/api/xo-candidate", "destination": "https://intentguard-api-production.up.railway.app/api/xo-candidate" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' wss://relay.riften.net:443; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" }
  ] }]
}
